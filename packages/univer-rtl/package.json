{
  "name": "@naf-sheets/univer-rtl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Right-to-left grid for Univer 1.4.0 (production copy of spike/univer/src/rtl-grid.ts).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "harness:typecheck": "tsc --noEmit -p harness",
    "harness:build": "vite build --config harness/vite.config.ts",
    "harness:preview": "vite preview --config harness/vite.config.ts",
    "test:rtl": "node test/rtl-interactions.mjs",
    "perf:rtl": "node scripts/rtl-perf.mjs",
    "check:pins": "node scripts/check-pins.mjs"
  },
  "dependencies": {
    "@univerjs/core": "1.4.0",
    "@univerjs/docs-ui": "1.4.0",
    "@univerjs/engine-formula": "1.4.0",
    "@univerjs/engine-render": "1.4.0",
    "@univerjs/presets": "1.4.0",
    "@univerjs/sheets": "1.4.0",
    "@univerjs/sheets-formula-ui": "1.4.0",
    "@univerjs/sheets-ui": "1.4.0",
    "@univerjs/ui": "1.4.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@univerjs/preset-sheets-core": "1.4.0",
    "@univerjs/preset-sheets-conditional-formatting": "1.4.0",
    "@univerjs/preset-sheets-filter": "1.4.0",
    "@univerjs/preset-sheets-sort": "1.4.0",
    "@univerjs/preset-sheets-data-validation": "1.4.0",
    "@univerjs/preset-sheets-hyper-link": "1.4.0",
    "@univerjs/preset-sheets-note": "1.4.0",
    "@univerjs/preset-sheets-drawing": "1.4.0",
    "@univerjs/preset-sheets-find-replace": "1.4.0",
    "@dawod/thmanyah-font-web": "1.2.0",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "7.1.12"
  }
}
